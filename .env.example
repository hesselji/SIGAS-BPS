APP_NAME="PENA MAS"
APP_ENV=local
APP_URL=http://127.0.0.1:8080
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
DB_TIMEZONE=+07:00

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agenda_surat_bps
DB_USERNAME=root
DB_PASSWORD=

# Admin harus re-auth saat membuka Rahasia/Sangat Rahasia.
# Durasi grant akses untuk satu surat, dalam detik (default 5 menit).
CONFIDENTIAL_REAUTH_SECONDS=300
